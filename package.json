{
    "name": "n8n-nodes-zoominfo",
    "version": "0.1.0",
    "description": "n8n community node for the ZoomInfo GTM API: contact and company search and enrichment, intent, scoops, news, and usage",
    "license": "MIT",
    "homepage": "https://github.com/Zoominfo/n8n-nodes-zoominfo#readme",
    "keywords": [
        "n8n-community-node-package",
        "n8n",
        "zoominfo",
        "gtm",
        "sales-intelligence",
        "enrichment"
    ],
    "author": {
        "name": "parkersequeira-zi",
        "email": "parker.sequeira@zoominfo.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Zoominfo/n8n-nodes-zoominfo.git"
    },
    "bugs": {
        "url": "https://github.com/Zoominfo/n8n-nodes-zoominfo/issues"
    },
   "scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"smoke": "npm run build && node scripts/smoke.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/ZoomInfoOAuth2Api.credentials.js",
            "dist/credentials/ZoomInfoPkceOAuth2Api.credentials.js"
        ],
        "nodes": [
            "dist/nodes/ZoomInfo/ZoomInfo.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
